" .ideavimrc
" IdeaVim-compatible config derived from vimrc + init.lua

" ============================================================
" PLUGINS (IdeaVim bundled handlers)
" ============================================================
set surround         " tpope/vim-surround
set commentary       " tpope/vim-commentary

" ============================================================
" LEADER
" ============================================================
map <Space> <Nop>
let mapleader = " "

" ============================================================
" GENERAL
" ============================================================
set number
set relativenumber
set visualbell
set scrolloff=3

set wrap
set showmode
set showcmd

" ============================================================
" SEARCH
" ============================================================
set hlsearch
set incsearch
set ignorecase
set smartcase

map N Nzz
map n nzz

nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

nnoremap <silent> <leader><CR> :nohlsearch<CR>

" ============================================================
" EDITING CONVENIENCE
" ============================================================

" C-c acts like Escape
inoremap <C-c> <Esc>

" Insert blank lines without entering insert mode
nnoremap <silent> zj :set paste<CR>o<Esc>:set nopaste<CR>
nnoremap <silent> zk :set paste<CR>O<Esc>:set nopaste<CR>

" Arrow keys respect wrapped lines in insert mode
inoremap <silent> <Up>   <Esc>gka
inoremap <silent> <Down> <Esc>gja

" ============================================================
" CLIPBOARD / REGISTERS
" ============================================================
nnoremap <leader>y :"+yy<CR>
xnoremap <leader>y :y+<CR>

" Paste over selection without clobbering yank register
xnoremap <silent> <leader>p "_dP

" Paste from yank register (0)
nnoremap <silent> <leader>p "0p

" ============================================================
" TABS
" ============================================================
nnoremap <silent> <C-t> :tabnew<CR>

noremap <leader>1 1gt
noremap <leader>2 2gt
noremap <leader>3 3gt
noremap <leader>4 4gt
noremap <leader>5 5gt
noremap <leader>6 6gt
noremap <leader>7 7gt
noremap <leader>8 8gt
noremap <leader>9 9gt
noremap <leader>0 :tablast<cr>

" Jump to last active tab
au TabLeave * let g:lasttab = tabpagenr()
nnoremap <silent> <leader>l :exe "tabn ".g:lasttab<cr>
vnoremap <silent> <leader>l :exe "tabn ".g:lasttab<cr>

" ============================================================
" IDE ACTIONS (IdeaVim <Action> mappings)
" ============================================================

" Search / navigation (fzf-lua equivalents)
nnoremap <leader>ff :action GotoFile<CR>
nnoremap <leader>fl :action FindInPath<CR>
nnoremap <leader>fs :action GotoSymbol<CR>
nnoremap <leader>fx :action SearchEverywhere<CR>
nnoremap <leader>fb :action Annotate<CR>
nnoremap <leader>fc :action GotoClass<CR>

" Hover / quick documentation
nnoremap <leader>e :action ShowHoverInfo<CR>

" LSP-equivalent actions
nnoremap <leader>r  :action RenameElement<CR>
nnoremap grn        :action RenameElement<CR>
nnoremap gra        :action ShowIntentionActions<CR>
vnoremap gra        :action ShowIntentionActions<CR>
nnoremap grr        :action FindUsages<CR>
nnoremap gri        :action GotoImplementation<CR>

" Show usages
nnoremap <Leader>u :action FindUsages<CR>

" Show diagnostics for current line (Problems View)
nnoremap <Leader>d :action ShowErrorDescription<CR>

" Navigate diagnostics
nnoremap <C-n> :action GotoNextError<CR>
nnoremap <C-p> :action GotoPreviousError<CR>

" Toggle between header and source file (.h <-> .cpp)
nnoremap <leader>o :action SwitchHeaderSource<CR>

" Toggle bottom tool windows
nnoremap <leader>j  :action HideActiveToolWindow<CR>
nnoremap <leader>jb :action ActivateBuildToolWindow<CR>
nnoremap <leader>jp :action ActivateProblemsViewToolWindow<CR>
nnoremap <leader>jg :action ActivateVersionControlToolWindow<CR>

" File tree toggle (Project tool window)
nnoremap <leader>t :action ActivateProjectToolWindow<CR>

" Go to config files (open in new tab)
nnoremap <silent> <leader>rc :tabnew ~/.vimrc<CR>
nnoremap <silent> <leader>rl :tabnew ~/.config/nvim/init.lua<CR>

" Build
nnoremap <leader>b :action BuildSolutionAction<CR>

" ============================================================
" SPELLCHECK TOGGLE
" ============================================================
function! ToggleSpellCheck()
    set spell!
    if &spell
        echo "Spellcheck ON"
    else
        echo "Spellcheck OFF"
    endif
endfunction

nnoremap <silent> <leader>s :call ToggleSpellCheck()<CR>

" ============================================================
" MISC DISPLAY
" ============================================================
" Hex view toggle (xxd)
function! ToggleHex()
    if !exists("b:file_xxd") || b:file_xxd == 0
        %!xxd
        let b:file_xxd = 1
    else
        %!xxd -r
        let b:file_xxd = 0
    endif
endfunction

nnoremap <leader>h :call ToggleHex()<CR>
